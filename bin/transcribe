#!/usr/bin/env bash
# transcribe — pasa audio o vídeo a texto con Whisper, sin separar voces.
# Corre directo desde el clon, sin instalar el paquete (ver bin/transcribe-speakers).
set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(dirname "$(dirname "$SELF")")"
PYTHONPATH="$REPO/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m transcriber.transcribe "$@"
