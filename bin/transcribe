#!/usr/bin/env bash
# transcribe — pasa audio o vídeo a texto con Whisper (faster-whisper / CTranslate2).
# Motor: whisper-ctranslate2 (instalado con `uv tool install`).
set -euo pipefail

TOOL_ENV="$HOME/.local/share/uv/tools/whisper-ctranslate2/lib/python3.12/site-packages"
NV="$TOOL_ENV/nvidia"

MODEL="large-v3-turbo"
LANG=""
OUTDIR=""
FORMAT="txt"
DEVICE="auto"
EXTRA=()

usage() {
  cat <<'EOF'
transcribe — pasa audio o vídeo a texto con Whisper

  transcribe [opciones] fichero [fichero...]

Opciones
  -m, --model MODELO    tiny | base | small | medium | large-v3 | large-v3-turbo
                        (por defecto: large-v3-turbo)
  -l, --language IDIOMA es, en, fr... (por defecto: se detecta solo)
  -f, --format FORMATO  txt | srt | vtt | tsv | json | all  (por defecto: txt)
  -o, --output-dir DIR  dónde dejar el resultado (por defecto: junto al fichero)
      --cpu / --gpu     forzar CPU o GPU (por defecto: GPU si hay, si no CPU)
  -h, --help            esta ayuda
  --                    todo lo que venga después se pasa tal cual a
                        whisper-ctranslate2 (ver `whisper-ctranslate2 --help`)

Ejemplos
  transcribe clase.mp4                       # texto junto al vídeo
  transcribe -l es -f srt entrevista.mkv     # subtítulos en español
  transcribe -m medium --cpu podcast.mp3
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--model)          MODEL="$2"; shift 2 ;;
    -l|--lang|--language) LANG="$2"; shift 2 ;;
    -f|--format)         FORMAT="$2"; shift 2 ;;
    -o|--output-dir)     OUTDIR="$2"; shift 2 ;;
    --cpu)               DEVICE="cpu"; shift ;;
    --gpu|--cuda)        DEVICE="cuda"; shift ;;
    -h|--help)           usage; exit 0 ;;
    --)                  shift; EXTRA+=("$@"); break ;;
    -*)                  echo "transcribe: opción desconocida '$1' (usa -- para pasarla al motor)" >&2; exit 2 ;;
    *)                   break ;;
  esac
done

# los ficheros son lo que queda antes de `--`
FILES=()
while [[ $# -gt 0 && "$1" != "--" ]]; do FILES+=("$1"); shift; done

if [[ ${#FILES[@]} -eq 0 ]]; then usage; exit 2; fi

has_gpu() {
  [[ -f "$NV/cublas/lib/libcublas.so.12" && -f "$NV/cudnn/lib/libcudnn.so.9" ]] || return 1
  command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1
}

if [[ "$DEVICE" == "auto" ]]; then
  if has_gpu; then DEVICE="cuda"; else DEVICE="cpu"; fi
fi

if [[ "$DEVICE" == "cuda" ]]; then
  COMPUTE="int8_float16"
  export LD_LIBRARY_PATH="$NV/cublas/lib:$NV/cudnn/lib:$NV/cuda_nvrtc/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
  COMPUTE="int8"
fi

run_one() {
  local file="$1" device="$2" compute="$3" dir
  dir="${OUTDIR:-$(dirname -- "$file")}"
  local args=(
    --model "$MODEL"
    --device "$device"
    --compute_type "$compute"
    --output_dir "$dir"
    --output_format "$FORMAT"
    --vad_filter False
    --threads 8
  )
  [[ -n "$LANG" ]] && args+=(--language "$LANG")
  [[ ${#EXTRA[@]} -gt 0 ]] && args+=("${EXTRA[@]}")
  whisper-ctranslate2 "${args[@]}" -- "$file"
}

status=0
for f in "${FILES[@]}"; do
  if [[ ! -f "$f" ]]; then
    echo "transcribe: no existe '$f'" >&2
    status=1
    continue
  fi
  echo "==> $f  (modelo $MODEL, $DEVICE)"
  if ! run_one "$f" "$DEVICE" "$COMPUTE"; then
    if [[ "$DEVICE" == "cuda" ]]; then
      echo "transcribe: falló en GPU, reintentando en CPU..." >&2
      run_one "$f" "cpu" "int8" || status=1
    else
      status=1
    fi
  fi
done
exit "$status"
